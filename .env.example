# ==========================================
# Placement Launchpad AI - Environment Config
# ==========================================

# BACKEND SERVICE (Deploy on Render / Railway / Server)
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas persistent cloud database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placement_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_production_jwt_secret_key_here

# AI Integration (Google Gemini API - Kept strictly on server)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS: Deployed Frontend Client URL
CLIENT_URL=https://your-frontend.vercel.app

# ==========================================
# FRONTEND SERVICE (Deploy on Vercel / Netlify / Render)
# ==========================================
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
