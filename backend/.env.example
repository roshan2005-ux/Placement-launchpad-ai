PORT=5000
NODE_ENV=development

# Persistent Database (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placement_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key (Server-side only; never committed or exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Frontend Client Origin(s) for Production CORS (comma-separated)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
